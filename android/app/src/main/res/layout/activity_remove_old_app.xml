<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dash_bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:isScrollContainer="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Remove old app copy"
            android:textColor="@color/dash_cream"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/removeOldPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/field"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="48dp"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/dash_cream"
            android:textColorHint="@color/dash_muted"
            android:textSize="16sp" />

        <Button
            android:id="@+id/removeOldCopy"
            style="@style/Widget.Stellar.Accent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:contentDescription="Remove old app copy"
            android:text="Remove" />

        <TextView
            android:id="@+id/removeOldStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/dash_muted"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
